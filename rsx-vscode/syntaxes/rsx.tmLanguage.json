{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSX",
  "scopeName": "source.rsx",
  "patterns": [
    {
      "include": "source.rust"
    },
    {
      "include": "#rsx-macro"
    }
  ],
  "repository": {
    "rsx-macro": {
      "begin": "\\b(rsx)\\s*!\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.macro.rust"
        }
      },
      "patterns": [
        {
          "include": "#rsx-content"
        }
      ]
    },
    "rsx-content": {
      "patterns": [
        {
          "include": "#html-element"
        },
        {
          "include": "#rust-expression"
        },
        {
          "include": "#text-content"
        }
      ]
    },
    "html-element": {
      "begin": "<([a-zA-Z][a-zA-Z0-9_-]*)",
      "end": "(/>)|((</)(\\1)(>))",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.html"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.html"
        },
        "4": {
          "name": "entity.name.tag.html"
        },
        "5": {
          "name": "punctuation.definition.tag.html"
        }
      },
      "patterns": [
        {
          "include": "#html-attribute"
        },
        {
          "match": ">",
          "name": "punctuation.definition.tag.html"
        },
        {
          "include": "#rsx-content"
        }
      ]
    },
    "html-attribute": {
      "patterns": [
        {
          "begin": "([a-zA-Z_:][a-zA-Z0-9_:.-]*)\\s*(=)\\s*\\{",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            }
          },
          "patterns": [
            {
              "include": "source.rust"
            }
          ]
        },
        {
          "begin": "([a-zA-Z_:][a-zA-Z0-9_:.-]*)\\s*(=)\\s*\"",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            }
          },
          "contentName": "string.quoted.double.html",
          "patterns": [
            {
              "include": "#rust-interpolation"
            }
          ]
        },
        {
          "begin": "([a-zA-Z_:][a-zA-Z0-9_:.-]*)\\s*(=)\\s*'",
          "end": "'",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            }
          },
          "contentName": "string.quoted.single.html",
          "patterns": [
            {
              "include": "#rust-interpolation"
            }
          ]
        },
        {
          "match": "[a-zA-Z_:][a-zA-Z0-9_:.-]*",
          "name": "entity.other.attribute-name.html"
        }
      ]
    },
    "rust-expression": {
      "begin": "\\{(?!\\{)",
      "end": "\\}",
      "contentName": "meta.embedded.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "rust-interpolation": {
      "begin": "\\{(?!\\{)",
      "end": "\\}",
      "contentName": "meta.embedded.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "text-content": {
      "patterns": [
        {
          "match": "\\{\\{",
          "name": "constant.character.escape.rsx"
        },
        {
          "match": "\\}\\}",
          "name": "constant.character.escape.rsx"
        },
        {
          "match": "[^<{]+",
          "name": "text.html"
        }
      ]
    }
  }
}